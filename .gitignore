```gitignore
# ============================================================
# SheSignal - Git Ignore
# React / Python / FastAPI / Supabase / Groq
# ============================================================

# -------------------------
# Environment / Secrets
# -------------------------
.env
.env.*
!.env.example

*.pem
*.key
*.crt
secrets/
credentials/
tests/
*.secret

# -------------------------
# Node / React / Vite
# -------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

dist/
build/
.vite/
.cache/
.parcel-cache/
.turbo/

# React / Next.js (if applicable)
.next/
out/

# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Python build files
build/
dist/
*.egg-info/
.eggs/

# Coverage / testing
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checking / linting
.mypy_cache/
.pyright/
.ruff_cache/

# -------------------------
# FastAPI / Uvicorn
# -------------------------
*.log
logs/

# -------------------------
# Supabase
# -------------------------
# Keep migrations and SQL files tracked!
# Ignore local Supabase generated/runtime data

.supabase/
supabase/.branches/
supabase/.temp/

# -------------------------
# IDEs / Editors
# -------------------------
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json

.idea/
*.iml

# -------------------------
# OS generated files
# -------------------------
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# -------------------------
# Temporary files
# -------------------------
*.tmp
*.temp
*.swp
*.swo
*~
*.bak

# -------------------------
# Test artifacts
# -------------------------
.pytest_cache/
test-results/
coverage/
htmlcov/

# -------------------------
# Local databases / data
# -------------------------
*.db
*.sqlite
*.sqlite3

# -------------------------
# Uploaded / generated files
# -------------------------
uploads/
tmp/
temp/
generated/
*.csv
*.xlsx

# -------------------------
# Jupyter
# -------------------------
.ipynb_checkpoints/

# -------------------------
# AI / ML local files
# -------------------------
models/
checkpoints/
*.bin
*.safetensors
*.pt
*.pth

# -------------------------
# Deployment
# -------------------------
.vercel/
.netlify/

# -------------------------
# Misc
# -------------------------
.DS_Store
*.log
```
